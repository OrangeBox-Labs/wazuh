<!-- ================================================================
     ATAQUES WEB / FUERZA BRUTA / RECONOCIMIENTO
     ================================================================

     Convencion de IDs OrangeBox:
         10000 - 19999 = Reglas de deteccion.
         20000 - 29999 = Excepciones / whitelists.

     IMPORTANTE:
         Las reglas de deteccion se definen primero.
         Las excepciones / whitelists se encuentran EXCLUSIVAMENTE
         al FINAL de este archivo.

         Las reglas que utilizan <if_sid> o <if_matched_sid> deben
         referenciar reglas definidas previamente cuando corresponda.

         Las expresiones sobre <url> utilizan PCRE2 de forma explicita.
================================================================ -->

<!-- ================================================================
     REGLAS DE DETECCION
     ================================================================ -->

<group name="orangebox,web,authentication,attack,">

    <!--
        10024
        ------------------------------------------------------------
        Regla BASE de autenticacion web.

        Cada respuesta HTTP 401 o 403 genera este evento.
        31101 identifica las respuestas HTTP 4xx.
    -->

    <rule id="10024" level="5">
        <if_sid>31101</if_sid>
        <id>^401$|^403$</id>
        <description>HTTP 401/403 detectado contra servidor web.</description>
        <group>web,authentication,orangebox_web,</group>
    </rule>

    <!--
        10023
        ------------------------------------------------------------
        DETECCION DE URL SENSIBLE.

        Esta regla NO depende de 10024.

        Un scanner puede recibir diferentes respuestas al probar una
        ruta sensible:
            401 = protegido
            403 = prohibido
            404 = no existe

        Un 404 sigue siendo relevante para detectar reconocimiento
        automatizado de rutas conocidas de credenciales o secretos.

        31101 representa cualquier HTTP 4xx, por lo que 10023 tambien
        puede detectar respuestas 404.
    -->

    <rule id="10023" level="5">
        <if_sid>31101</if_sid>
        <url type="pcre2">^/\.env|^/\.aws/|^/\.config/gcloud/|^/\.oci/|^/\.openai/|^/wp-config\.php|^/@fs/.*(\.env|\.aws/|\.config/gcloud/|\.oci/|\.openai/|wp-config\.php)</url>
        <description>HTTP 4xx contra archivo sensible o credencial potencial.</description>
        <group>web,reconnaissance,credential_discovery,sensitive_file,orangebox_web,</group>
    </rule>

    <!--
        10025
        ------------------------------------------------------------
        FUERZA BRUTA WEB.

        Correlaciona multiples respuestas HTTP 401/403 desde la misma
        IP dentro de 15 segundos.

        Las rutas de reconocimiento de archivos sensibles se excluyen
        para no clasificarlas como brute force.

        Nivel 13:
        se considera un evento de alta importancia y supera el umbral
        de la integracion de correo OrangeBox.

        Active Response:
        firewall-drop bloquea el origen durante 24 horas.
    -->

    <rule id="10025" level="13" frequency="10" timeframe="15">
        <if_matched_sid>10024</if_matched_sid>
        <id>^401$|^403$</id>
        <url type="pcre2" negate="yes">^/\.env|^/\.aws/|^/\.config/gcloud/|^/\.oci/|^/\.openai/|^/wp-config\.php|^/@fs/.*(\.env|\.aws/|\.config/gcloud/|\.oci/|\.openai/|wp-config\.php)</url>
        <same_srcip />
        <description>ALERTA CRITICA: Posible fuerza bruta web. Multiples respuestas HTTP 401/403 desde la misma IP.</description>
        <mitre>
            <id>T1110</id>
        </mitre>
        <group>web,authentication,brute_force,attack,orangebox_web,</group>
    </rule>

    <!--
        10026
        ------------------------------------------------------------
        DESCUBRIMIENTO AUTOMATIZADO DE ARCHIVOS SENSIBLES / CREDENCIALES.

        Correlaciona 2 eventos 10023 desde la misma IP dentro de
        30 segundos.

        Como 10023 acepta cualquier HTTP 4xx, se incluyen respuestas
        401, 403 y 404.

        Nivel 14:
        evento de alta importancia de seguridad y supera el umbral
        de la integracion de correo OrangeBox.

        Active Response:
        firewall-drop bloquea el origen durante 24 horas.
    -->

    <rule id="10026" level="14" frequency="2" timeframe="30">
        <if_matched_sid>10023</if_matched_sid>
        <same_srcip />
        <description>ALERTA CRITICA: Posible reconocimiento automatizado de archivos sensibles o credenciales web. Multiples intentos desde la misma IP.</description>
        <mitre>
            <id>T1083</id>
            <id>T1552</id>
        </mitre>
        <group>web,reconnaissance,credential_discovery,sensitive_file,attack,orangebox_web,</group>
    </rule>

</group>

<!-- =================================================================
     EXCEPCIONES / WHITELIST - ESTA SECCION SIEMPRE VA AL FINAL
     =================================================================

     Convencion de IDs:
         20000 - 29999 = Excepciones / whitelists.
     ================================================================= -->

<group name="orangebox,web,authentication,whitelist,">

    <!-- Reverse proxy legitimo 192.168.200.7 -->
    <rule id="20024" level="3">
        <if_sid>10025</if_sid>
        <srcip>192.168.200.7</srcip>
        <description>EXCEPCION: Rafaga HTTP 401/403 proveniente del reverse proxy legitimo 192.168.200.7.</description>
        <group>web,authentication,orangebox_exception,orangebox_whitelist,</group>
    </rule>

    <!-- Reverse proxy legitimo 192.168.200.13 -->
    <rule id="20025" level="3">
        <if_sid>10025</if_sid>
        <srcip>192.168.200.13</srcip>
        <description>EXCEPCION: Rafaga HTTP 401/403 proveniente del reverse proxy legitimo 192.168.200.13.</description>
        <group>web,authentication,orangebox_exception,orangebox_whitelist,</group>
    </rule>

</group>
