<!-- ================================================================
     ATAQUES WEB / FUERZA BRUTA / RECONOCIMIENTO
     ================================================================

     Convencion de IDs OrangeBox:
         10000 - 19999 = Reglas de deteccion.
         20000 - 29999 = Excepciones / whitelists.

     IMPORTANTE:
         Las reglas de deteccion se definen primero.
         Las excepciones / whitelists se encuentran EXCLUSIVAMENTE
         al FINAL de este archivo.

         10024 es una regla BASE de contexto y usa noalert="1" para
         permitir que el mismo evento continue evaluandose por las
         reglas de correlacion 10025 y 10026.
================================================================ -->

<!-- ================================================================
     REGLAS DE DETECCION
     ================================================================ -->

<group name="orangebox,web,authentication,attack,">

    <!--
        10024
        ------------------------------------------------------------
        Regla BASE de contexto.

        Cada respuesta HTTP 401 o 403 pasa por esta regla.

        noalert="1" es intencional: el evento debe continuar siendo
        evaluado por las reglas de correlacion que vienen despues.

        En esta instalacion:
            31100 = regla base del web-accesslog
            31101 = Web server 400 error code (HTTP 4xx)

        31101 es el SID que recibe el evento antes de OrangeBox.
    -->

    <rule id="10024" level="5" noalert="1">
        <if_sid>31101</if_sid>
        <id>^401$|^403$</id>
        <description>HTTP 401/403 detectado contra servidor web.</description>
        <group>web,authentication,orangebox_web,</group>
    </rule>

    <!--
        10025
        ------------------------------------------------------------
        FUERZA BRUTA WEB.

        Correlaciona multiples respuestas HTTP 401/403 desde la misma
        IP dentro de 15 segundos.

        Las rutas de reconocimiento de archivos sensibles se excluyen
        explicitamente para que no sean clasificadas como brute force.
    -->

    <rule id="10025" level="13" frequency="10" timeframe="15">
        <if_matched_sid>10024</if_matched_sid>
        <id>^401$|^403$</id>
        <url negate="yes">^/\.env|^/\.aws/|^/\.config/gcloud/|^/\.oci/|^/\.openai/|^/wp-config\.php|^/@fs/.*(\.env|\.aws/|\.config/gcloud/|\.oci/|\.openai/|wp-config\.php)</url>
        <same_srcip />
        <description>ALERTA: Posible fuerza bruta web. Multiples respuestas HTTP 401/403 desde la misma IP.</description>
        <mitre>
            <id>T1110</id>
        </mitre>
        <group>web,authentication,brute_force,attack,orangebox_web,</group>
    </rule>

    <!--
        10026
        ------------------------------------------------------------
        DESCUBRIMIENTO DE ARCHIVOS SENSIBLES / CREDENCIALES.

        Correlaciona directamente eventos 10024 que ademas coinciden
        con una ruta sensible.

        Requiere 2 coincidencias desde la misma IP dentro de 30 segundos.
        El filtro sensible se aplica aqui, por lo que no necesitamos una
        regla intermedia 10023.

        Nivel 15: Active Response puede ejecutar firewall-drop.
    -->

    <rule id="10026" level="15" frequency="2" timeframe="30">
        <if_matched_sid>10024</if_matched_sid>
        <id>^401$|^403$</id>
        <url>^/\.env|^/\.aws/|^/\.config/gcloud/|^/\.oci/|^/\.openai/|^/wp-config\.php|^/@fs/.*(\.env|\.aws/|\.config/gcloud/|\.oci/|\.openai/|wp-config\.php)</url>
        <same_srcip />
        <description>ALERTA CRITICA: Posible reconocimiento automatizado de archivos sensibles o credenciales web. Multiples intentos desde la misma IP.</description>
        <mitre>
            <id>T1083</id>
            <id>T1552</id>
        </mitre>
        <group>web,reconnaissance,credential_discovery,sensitive_file,attack,orangebox_web,</group>
    </rule>

</group>


<!-- =================================================================
     EXCEPCIONES / WHITELIST - ESTA SECCION SIEMPRE VA AL FINAL
     =================================================================

     Convencion de IDs:
         20000 - 29999 = Excepciones / whitelists.

     Estas reglas NO detectan actividad maliciosa.
     Su objetivo es evitar que actividad previamente validada y
     operacionalmente legitima sea tratada como alerta OrangeBox.

     IMPORTANTE:
         - No agregar IPs, usuarios o servicios sin validacion previa.
         - Las excepciones deben ser lo mas especificas posible.
         - No utilizar una whitelist como sustituto de una regla de deteccion.
         - Esta seccion debe permanecer despues de TODAS las reglas 10000-19999.
     ================================================================= -->

<group name="orangebox,web,authentication,whitelist,">

    <!-- Reverse proxy legitimo 192.168.200.7 -->
    <rule id="20024" level="3">
        <if_sid>10025</if_sid>
        <srcip>192.168.200.7</srcip>
        <description>EXCEPCION: Rafaga HTTP 401/403 proveniente del reverse proxy legitimo 192.168.200.7.</description>
        <group>web,authentication,orangebox_exception,orangebox_whitelist,</group>
    </rule>

    <!-- Reverse proxy legitimo 192.168.200.13 -->
    <rule id="20025" level="3">
        <if_sid>10025</if_sid>
        <srcip>192.168.200.13</srcip>
        <description>EXCEPCION: Rafaga HTTP 401/403 proveniente del reverse proxy legitimo 192.168.200.13.</description>
        <group>web,authentication,orangebox_exception,orangebox_whitelist,</group>
    </rule>

</group>
