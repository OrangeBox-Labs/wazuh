<!--
    OrangeBox Wazuh - Reglas de autenticacion
    ================================================================

    Proposito:
        - Inicios de sesion SSH exitosos.
        - Uso de sudo.
        - Elevacion mediante su a root.
        - Fuerza bruta SSH seguida de login exitoso.
        - Movimiento lateral dentro de redes internas.
        - Control de sudo -> root mediante whitelist de comandos.

    Convencion de IDs OrangeBox:
        10000 - 19999 = Reglas de deteccion.
        20000 - 29999 = Excepciones / whitelists.

    IMPORTANTE:
        Las reglas de deteccion se definen primero.
        Las excepciones / whitelists se encuentran EXCLUSIVAMENTE
        al FINAL de este archivo.

        No mover la seccion de whitelist antes de las reglas de deteccion.

    No sobrescribimos reglas nativas de Wazuh.
    Las reglas OrangeBox se construyen como reglas hijas cuando corresponde.
-->

<!-- ================================================================
     REGLAS DE DETECCION
     ================================================================ -->

<!-- ================================================================
     SSH - AUTENTICACION EXITOSA
     ================================================================ -->
<group name="orangebox,authentication,ssh,">

    <!--
        5715 = autenticacion SSH exitosa.

        IMPORTANTE:
        La regla nativa 5715 tambien puede clasificar mensajes auxiliares
        que comienzan con "Accepted", por ejemplo:

            Accepted key RSA SHA256:... found at authorized_keys:1

        Ese mensaje NO confirma por si solo que una sesion SSH haya sido
        establecida y puede incluso aparecer mas de una vez.

        El evento que confirma el login contiene:

            Accepted publickey for USER from IP port PORT ssh2
            Accepted password for USER from IP port PORT ssh2
            Accepted keyboard-interactive/pam for USER from IP port PORT ssh2

        Usamos <regex type="pcre2"> en lugar de <match> porque necesitamos
        una expresion con alternativas.
    -->
    <rule id="10001" level="13">
        <if_sid>5715</if_sid>
        <regex type="pcre2">Accepted\s+(?:publickey|password|keyboard-interactive/pam)\s+for\s+\S+\s+from\s+\S+\s+port\s+\d+\s+ssh2</regex>
        <description>ALERTA: Inicio de sesion SSH exitoso.</description>
        <group>authentication_success,orangebox_auth,orangebox_ssh,</group>
    </rule>

</group>


<!-- ================================================================
     ELEVACION DE PRIVILEGIOS - SU / SUDO
     ================================================================

     IMPORTANTE:
         Toda elevacion exitosa a root mediante los mecanismos
         detectados por estas reglas pertenece al grupo
         privilege_escalation_root.

         La integracion de correo utiliza este grupo para enviar la
         alerta inmediatamente, sin pasar por el buffer.
     ================================================================ -->
<group name="orangebox,authentication,privilege_escalation,">

    <!-- 5501 = PAM login session opened. -->
    <rule id="10004" level="13">
        <if_sid>5501</if_sid>
        <match>su-l:session|su:session</match>
        <user>root</user>
        <description>ALERTA: Usuario cambio de sesion a ROOT mediante comando SU.</description>
        <group>authentication_success,privilege_escalation,privilege_escalation_root,orangebox_auth,</group>
    </rule>

    <!--
        5402 = Successful sudo to ROOT executed.

        La whitelist se mantiene dentro de esta misma regla mediante
        una expresion negativa sobre el campo dinamico "command".

        IMPORTANTE PARA ZIMBRA / CARBONIO:
          - Zimbra usa /opt/zimbra.
          - Carbonio CE usa /opt/zextras.
          - Ambos representan la misma familia de componentes y deben
            tener la misma politica de sudo.

        Los binarios autorizados son los mismos en ambos arboles.
        postconf se permite con sus argumentos porque Carbonio/Zimbra lo
        utiliza para regenerar la configuracion completa de Postfix.

        SEGURIDAD:
          - Solo se aceptan los ejecutables definidos explicitamente aqui.
          - No se acepta un binario arbitrario por pertenecer a /opt/zimbra
            o /opt/zextras.
          - La integridad de estos ejecutables se controla adicionalmente
            mediante FIM en agent.conf.
          - Cualquier otro sudo -> root dispara esta regla.
    -->
    <rule id="10005" level="13">
        <if_sid>5402</if_sid>
        <field name="command" negate="yes" type="pcre2">^(?:/opt/(?:zimbra|zextras)/(?:libexec/zmstat-fd(?:\s+.*)?|common/sbin/postfix|common/sbin/postalias|common/sbin/qshape\.pl|common/sbin/postconf(?:\s+.*)?|common/sbin/postsuper|common/sbin/postcat|libexec/zmqstat|libexec/zmmtastatus|libexec/zmmailboxdmgr status))$</field>
        <description>ALERTA CRITICA: SUDO hacia ROOT con comando NO autorizado por la whitelist OrangeBox.</description>
        <group>syslog,sudo,privilege_escalation,privilege_escalation_root,orangebox_auth,orangebox_sudo_whitelist_enforced,</group>
    </rule>

</group>


<!-- ================================================================
     SSH - FUERZA BRUTA COMPLETADA CON EXITO
     ================================================================ -->
<group name="orangebox,authentication,ssh,attack,">

    <rule id="10006" level="13">
        <if_sid>10001</if_sid>
        <if_matched_sid>5763</if_matched_sid>
        <same_source_ip/>
        <description>ALERTA: Fuerza Bruta SSH COMPLETADA CON EXITO. Login exitoso posterior a multiples fallos de autenticacion.</description>
        <group>authentication_success,authentication_failures,brute_force,attack,orangebox_ssh,orangebox_auth,</group>
    </rule>

</group>


<!-- ================================================================
     MOVIMIENTO LATERAL - SSH DESDE RED INTERNA
     ================================================================ -->
<group name="orangebox,authentication,lateral_movement,attack,">

    <rule id="10007" level="13">
        <if_sid>5712</if_sid>
        <match>from 192.168.|from 10.8.</match>
        <description>ALERTA: Posible movimiento lateral. Rafaga de fallos SSH desde la red interna.</description>
        <group>authentication_failed,lateral_movement,attack,orangebox_auth,privilege_escalation_root,</group>
    </rule>

</group>


<!-- =================================================================
     EXCEPCIONES / WHITELIST - ESTA SECCION SIEMPRE VA AL FINAL
     ================================================================= -->

<group name="orangebox,authentication,ssh,whitelist,">

    <!-- BackupPC 192.168.200.1 -->
    <rule id="20001" level="3">
        <if_sid>10001</if_sid>
        <srcip>192.168.200.1</srcip>
        <description>EXCEPCION: SSH exitoso legitimo desde BackupPC (192.168.200.1).</description>
        <group>authentication_success,orangebox_exception,orangebox_whitelist,</group>
    </rule>

    <!-- BackupPC 192.168.1.31 -->
    <rule id="20002" level="3">
        <if_sid>10001</if_sid>
        <srcip>192.168.1.31</srcip>
        <description>EXCEPCION: SSH exitoso legitimo desde BackupPC (192.168.1.31).</description>
        <group>authentication_success,orangebox_exception,orangebox_whitelist,</group>
    </rule>

    <!-- BackupPC 192.168.100.103 -->
    <rule id="20003" level="3">
        <if_sid>10001</if_sid>
        <srcip>192.168.100.103</srcip>
        <description>EXCEPCION: SSH exitoso legitimo desde BackupPC (192.168.100.103).</description>
        <group>authentication_success,orangebox_exception,orangebox_whitelist,</group>
    </rule>

    <!-- SFTP automatizado de certcoopeuch -->
    <rule id="20004" level="3">
        <if_sid>10001</if_sid>
        <srcip>190.171.174.116</srcip>
        <user>certcoopeuch</user>
        <description>EXCEPCION: Acceso SFTP automatizado legitimo de certcoopeuch.</description>
        <group>authentication_success,orangebox_exception,orangebox_whitelist,sftp,</group>
    </rule>

    <!-- SFTP automatizado de certcoopeuch - IP adicional -->
    <rule id="20005" level="3">
        <if_sid>10001</if_sid>
        <srcip>200.68.21.26</srcip>
        <user>certcoopeuch</user>
        <description>EXCEPCION: Acceso SFTP automatizado de certcoopeuch desde IP adicional autorizada.</description>
        <group>authentication_success,orangebox_exception,orangebox_whitelist,sftp,</group>
    </rule>

    <!--
        La antigua whitelist 20005 por UID 995 fue eliminada.
        No se debe filtrar SUDO por UID, usuario o identidad de Zimbra.
        El control correcto se realiza por comando en 10005.
    -->

</group>
