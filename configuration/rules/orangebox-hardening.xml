<!--
    OrangeBox - Hardening / File Integrity Monitoring
    Wazuh 4.14.x

    550 = syscheck_integrity_changed
    553 = syscheck_deleted

    NOTA SOBRE IPTABLES:
    /etc/sysconfig/iptables.save puede ser regenerado por servicios de
    persistencia de iptables. En ese proceso cambian normalmente la fecha
    de generacion y los contadores de paquetes/bytes, aunque ninguna regla
    del firewall haya sido modificada.

    Por este motivo iptables.save NO se utiliza como disparador de la alerta
    de hardening 10037. El archivo puede seguir siendo monitoreado por FIM,
    pero sus cambios normales no se elevan a una alerta de configuracion.

    La configuracion efectiva de iptables (/etc/sysconfig/iptables) sigue
    protegida. Los cambios reales de firewall se tratan mediante el contenido
    reportado por FIM (changed_content), sin depender de UID o proceso.

    IMPORTANTE:
        La regla 10038 genera alerta cuando el diff de /etc/sysconfig/iptables
        contiene cambios sobre reglas iptables (-A/-C/-D/-I/-R/-F/-N/-X/-P).
        Un service iptables save que solamente regenera timestamps y/o
        contadores no contiene estas lineas y no dispara la regla.

    Convencion de IDs OrangeBox:
        10000 - 19999 = Reglas de deteccion.
        20000 - 29999 = Excepciones / whitelists.

    IMPORTANTE:
        Las reglas de deteccion se definen primero.
        Las excepciones / whitelists se encuentran EXCLUSIVAMENTE
        al FINAL de este archivo.
-->

<!-- ================================================================
     REGLAS DE DETECCION - MODIFICACIONES
     ================================================================ -->

<group name="orangebox,hardening,fim,">

    <!-- Archivos de identidad y control de acceso -->
    <rule id="10030" level="13">
        <if_sid>550</if_sid>
        <field name="file">^/etc/passwd$|^/etc/shadow$|^/etc/group$|^/etc/gshadow$|^/etc/securetty$|^/etc/security/limits\.conf$</field>
        <description>ALERTA: Archivo critico de identidad o control de acceso modificado.</description>
        <group>identity,authentication,</group>
    </rule>

    <!-- Configuracion SSH -->
    <rule id="10031" level="13">
        <if_sid>550</if_sid>
        <field name="file">^/etc/ssh/|^/etc/sshd/</field>
        <description>ALERTA: Configuracion o archivo critico de SSH modificado.</description>
        <group>ssh,authentication,</group>
    </rule>

    <!-- Configuracion SUDO -->
    <rule id="10032" level="13">
        <if_sid>550</if_sid>
        <field name="file">^/etc/sudoers$|^/etc/sudoers\.d/|^/etc/sudoers\.conf$</field>
        <description>ALERTA: Configuracion de SUDO modificada.</description>
        <group>sudo,privilege_escalation,</group>
    </rule>

    <!-- Configuracion PAM -->
    <rule id="10033" level="13">
        <if_sid>550</if_sid>
        <field name="file">^/etc/pam\.d/</field>
        <description>ALERTA: Configuracion PAM modificada.</description>
        <group>pam,authentication,</group>
    </rule>

    <!-- Configuracion y unidades SYSTEMD -->
    <rule id="10034" level="13">
        <if_sid>550</if_sid>
        <field name="file">^/etc/systemd/system/|^/etc/systemd/user/</field>
        <description>ALERTA: Unidad o configuracion persistente de SYSTEMD modificada.</description>
        <group>systemd,persistence,</group>
    </rule>

    <!-- Configuracion CRON / ANACRON -->
    <rule id="10035" level="13">
        <if_sid>550</if_sid>
        <field name="file">^/etc/cron\.d/|^/etc/crontab$|^/etc/anacrontab$</field>
        <description>ALERTA: Configuracion de CRON o ANACRON modificada.</description>
        <group>cron,persistence,</group>
    </rule>

    <!-- Configuracion de red, DNS y montajes -->
    <rule id="10036" level="13">
        <if_sid>550</if_sid>
        <field name="file">^/etc/hosts$|^/etc/resolv\.conf$|^/etc/nsswitch\.conf$|^/etc/fstab$</field>
        <description>ALERTA: Configuracion critica de red, DNS o montaje modificada.</description>
        <group>network,dns,</group>
    </rule>

    <!--
        Configuracion de firewall, excepto /etc/sysconfig/iptables.
        iptables tiene una regla especifica debajo porque puede ser
        regenerado automaticamente por iptables-save cambiando solamente
        timestamps y contadores de paquetes/bytes.
    -->
    <rule id="10037" level="13">
        <if_sid>550</if_sid>
        <field name="file">^/etc/shorewall/|^/etc/firewalld/|^/etc/ufw/|^/etc/csf/|^/etc/sysconfig/iptables-config$|^/etc/sysconfig/nftables$|^/etc/sysconfig/nftables\.conf$|^/etc/nftables\.conf$|^/etc/imunify360/|^/etc/sysconfig/imunify360/</field>
        <description>ALERTA: Configuracion de FIREWALL modificada.</description>
        <group>firewall,network,</group>
    </rule>

    <!--
        /etc/sysconfig/iptables.

        'service iptables save' regenera el archivo mediante iptables-save.
        En un guardado sin cambios de reglas, el diff puede contener solo
        timestamps y contadores. Esos cambios no deben generar una alerta.

        En cambio, cuando una regla del ruleset cambia, iptables-save expone
        las entradas de reglas en formato -A/-C/-D/-I/-R/-F/-N/-X/-P. La
        regla 10038 busca esas lineas en changed_content.

        No se utiliza UID, usuario, proceso ni una whitelist ciega del
        archivo. La deteccion depende del contenido efectivo del diff.
    -->
    <rule id="10038" level="13">
        <if_sid>550</if_sid>
        <field name="file">^/etc/sysconfig/iptables$</field>
        <field name="changed_content" type="pcre2">(?m)^(?:&lt;|&gt;)\s+-[ACDIFNRXP]\b</field>
        <description>ALERTA: Configuracion de FIREWALL modificada.</description>
        <group>firewall,network,</group>
    </rule>

    <!--
        Integridad de comandos autorizados para SUDO -> ROOT.

        Estos archivos forman parte de la whitelist de orangebox-auth.xml.
        Si un atacante modifica uno de ellos, podria transformar un comando
        aparentemente permitido en una herramienta de escalamiento.

        La regla es deliberadamente de nivel 15 e incluye
        privilege_escalation_root para que la integracion de correo la trate
        como alerta inmediata.
    -->
    <rule id="10046" level="15">
        <if_sid>550</if_sid>
        <field name="file">^/opt/zimbra/libexec/zmstat-fd$|^/opt/zimbra/common/sbin/postfix$|^/opt/zimbra/common/sbin/postalias$|^/opt/zimbra/common/sbin/qshape\.pl$|^/opt/zimbra/common/sbin/postconf$|^/opt/zimbra/common/sbin/postsuper$|^/opt/zimbra/common/sbin/postcat$|^/opt/zimbra/libexec/zmqstat$|^/opt/zimbra/libexec/zmmtastatus$|^/opt/zimbra/libexec/zmmailboxdmgr$</field>
        <description>ALERTA CRITICA: Comando autorizado para SUDO -> ROOT fue modificado.</description>
        <group>sudo,privilege_escalation,privilege_escalation_root,integrity,orangebox_sudo_command_integrity,</group>
    </rule>

</group>


<!-- ================================================================
     REGLAS DE DETECCION - ELIMINACIONES
     ================================================================ -->

<group name="orangebox,hardening,fim,file_deletion,">

    <!-- Archivos de identidad y control de acceso -->
    <rule id="10040" level="15">
        <if_sid>553</if_sid>
        <field name="file">^/etc/passwd$|^/etc/shadow$|^/etc/group$|^/etc/gshadow$|^/etc/securetty$|^/etc/security/limits\.conf$</field>
        <description>ALERTA CRITICA: Archivo de identidad o control de acceso eliminado.</description>
        <group>identity,authentication,</group>
    </rule>

    <!-- Archivos y configuracion SSH -->
    <rule id="10041" level="15">
        <if_sid>553</if_sid>
        <field name="file">^/etc/ssh/|^/etc/sshd/</field>
        <description>ALERTA CRITICA: Archivo o configuracion de SSH eliminado.</description>
        <group>ssh,authentication,</group>
    </rule>

    <!-- Configuracion SUDO -->
    <rule id="10042" level="15">
        <if_sid>553</if_sid>
        <field name="file">^/etc/sudoers$|^/etc/sudoers\.d/|^/etc/sudoers\.conf$</field>
        <description>ALERTA CRITICA: Configuracion de SUDO eliminada.</description>
        <group>sudo,privilege_escalation,</group>
    </rule>

    <!-- Configuracion PAM -->
    <rule id="10043" level="15">
        <if_sid>553</if_sid>
        <field name="file">^/etc/pam\.d/</field>
        <description>ALERTA CRITICA: Configuracion PAM eliminada.</description>
        <group>pam,authentication,</group>
    </rule>

    <!-- Unidades y configuracion SYSTEMD -->
    <rule id="10044" level="15">
        <if_sid>553</if_sid>
        <field name="file">^/etc/systemd/system/|^/etc/systemd/user/</field>
        <description>ALERTA CRITICA: Unidad o configuracion persistente de SYSTEMD eliminada.</description>
        <group>systemd,persistence,</group>
    </rule>

    <!-- Configuracion CRON / ANACRON -->
    <rule id="10045" level="15">
        <if_sid>553</if_sid>
        <field name="file">^/etc/cron\.d/|^/etc/crontab$|^/etc/anacrontab$</field>
        <description>ALERTA CRITICA: Configuracion de CRON o ANACRON eliminada.</description>
        <group>cron,persistence,</group>
    </rule>

    <!-- Eliminacion de un comando autorizado para SUDO -> ROOT. -->
    <rule id="10047" level="15">
        <if_sid>553</if_sid>
        <field name="file">^/opt/zimbra/libexec/zmstat-fd$|^/opt/zimbra/common/sbin/postfix$|^/opt/zimbra/common/sbin/postalias$|^/opt/zimbra/common/sbin/qshape\.pl$|^/opt/zimbra/common/sbin/postconf$|^/opt/zimbra/common/sbin/postsuper$|^/opt/zimbra/common/sbin/postcat$|^/opt/zimbra/libexec/zmqstat$|^/opt/zimbra/libexec/zmmtastatus$|^/opt/zimbra/libexec/zmmailboxdmgr$</field>
        <description>ALERTA CRITICA: Comando autorizado para SUDO -> ROOT fue eliminado.</description>
        <group>sudo,privilege_escalation,privilege_escalation_root,integrity,orangebox_sudo_command_integrity,</group>
    </rule>

</group>


<!-- =================================================================
     EXCEPCIONES / WHITELIST - ESTA SECCION SIEMPRE VA AL FINAL
     =================================================================

     Actualmente no existen excepciones autorizadas para hardening.

     Cuando sea necesario agregar una excepcion, debe utilizar un ID
     entre 20000 y 29999 y referenciar explicitamente la regla OrangeBox
     correspondiente mediante <if_sid>.

     IMPORTANTE:
         - No agregar excepciones sin validar previamente el cambio.
         - Las excepciones deben ser lo mas especificas posible.
         - Esta seccion debe permanecer despues de TODAS las reglas de deteccion.
         - No crear un <group> vacio: si no hay excepciones, esta seccion
           permanece solamente como documentacion/comentarios.
     ================================================================= -->

