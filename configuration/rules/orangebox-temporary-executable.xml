<!--
    ORANGEBOX - Deteccion de archivos ejecutables en directorios temporales

    Objetivo
    Detectar archivos ejecutables en /tmp/, /var/tmp/ y /dev/shm/.

    Eventos FIM utilizados:
        554 = File added
        550 = File modified

    Convencion de IDs OrangeBox:
        10000 - 19999 = Reglas de deteccion
        20000 - 29999 = Excepciones y whitelists

    Excepcion operacional:
        dracut utiliza /var/tmp/dracut.* durante la construccion de initramfs.
        Esos arboles pueden generar gran cantidad de eventos FIM legitimos.
        La excepcion se limita exclusivamente a /var/tmp/dracut.*.

    IMPORTANTE:
        Las reglas y excepciones deben permanecer dentro del elemento group.
        Los comentarios XML no deben contener dobles guiones.
-->

<group name="orangebox_temporary_executable">

    <!--
        10410 - ARCHIVO CREADO YA EJECUTABLE

        Detecta archivos que aparecen en el sistema con algun permiso
        de ejecucion desde el momento en que FIM los registra.

        Ejemplo:
            install -m 755 /dev/null /var/tmp/test.sh

        Flujo FIM:
            554  = File added
            10410 = alerta OrangeBox
    -->
    <rule id="10410" level="15">
        <if_sid>554</if_sid>
        <field name="file" type="pcre2">^/tmp/|^/var/tmp/|^/dev/shm/</field>
        <field name="perm" type="pcre2">\w\wx</field>
        <description>
            ORANGEBOX: Executable file created in temporary directory.
        </description>
        <mitre>
            <id>T1105</id>
        </mitre>
    </rule>

    <!--
        10432 - ARCHIVO EXISTENTE AL QUE SE AGREGA EJECUCION

        Detecta cambios de permisos sobre archivos existentes.

        La regla requiere:
            550
            changed_fields = permission

        El permiso nuevo debe contener ejecucion en alguna de las tres
        posiciones correspondientes a owner, group u other.

        x = ejecucion
        s = ejecucion junto con setuid o setgid
        t = ejecucion junto con sticky

        S y T no cuentan porque representan setuid, setgid o sticky
        sin permiso de ejecucion.
    -->
    <rule id="10432" level="15">
        <if_sid>550</if_sid>
        <field name="file" type="pcre2">^/tmp/|^/var/tmp/|^/dev/shm/</field>
        <field name="changed_fields">^permission$</field>
        <field name="perm" type="pcre2">^(?=.*[xst])[r-][w-][xst-][r-][w-][xst-][r-][w-][xst-]$</field>
        <description>
            ORANGEBOX: Execute permission added to file in temporary directory.
        </description>
        <mitre>
            <id>T1222.002</id>
        </mitre>
    </rule>

    <!--
        20040 - EXCEPCION DRACUT PARA 10410

        dracut genera arboles temporales bajo /var/tmp/dracut.* durante
        la construccion de initramfs.

        Esta excepcion solamente actua sobre eventos que ya fueron
        identificados por la regla 10410 y cuyo path comienza exactamente
        con /var/tmp/dracut.

        El resto de /tmp, /var/tmp y /dev/shm continua bajo deteccion.
    -->
    <rule id="20040" level="0">
        <if_sid>10410</if_sid>
        <field name="file" type="pcre2">^/var/tmp/dracut\.</field>
        <description>
            EXCEPCION ORANGEBOX: archivo ejecutable generado por dracut.
        </description>
        <group>orangebox_exception,orangebox_whitelist,</group>
    </rule>

    <!--
        20041 - EXCEPCION DRACUT PARA 10432

        Descarta los cambios de permisos detectados por 10432 cuando
        el archivo pertenece al arbol /var/tmp/dracut.*.
    -->
    <rule id="20041" level="0">
        <if_sid>10432</if_sid>
        <field name="file" type="pcre2">^/var/tmp/dracut\.</field>
        <description>
            EXCEPCION ORANGEBOX: cambio de permisos generado por dracut.
        </description>
        <group>orangebox_exception,orangebox_whitelist,</group>
    </rule>

</group>
